      <column aggregation='None' datatype='integer' name='[Age (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='0' formula='[age]' peg='0' size='4.46' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_0043216189661184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age]&gt;=18 AND [age]&lt;=30 THEN &quot;Teenager&quot;&#13;&#10;ELSEIF [age] &lt;= 40 THEN &quot;Young Adult&quot;&#13;&#10;ELSEIF [age] &lt;= 50 THEN &quot;Adult&quot;&#13;&#10;ELSEIF [age] &lt;= 60 THEN &quot;Middle Age&quot;&#13;&#10;ELSEIF [age] &lt;= 70 THEN &quot;Senior&quot;&#13;&#10;ELSE &quot;Old&quot;&#13;&#10;END' />
      </column>
      <column caption='BMI Category' datatype='string' name='[Calculation_1510240528482304]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bmi] &lt;18.5 THEN &quot;Under Weight&quot;&#13;&#10;ELSEIF  [bmi]&gt;=18.5 AND [bmi]&lt;25 THEN &quot;Healty&quot;&#13;&#10;ELSEIF  [bmi]&gt;=25 AND [bmi]&lt;30 THEN &quot;Overweight&quot;&#13;&#10;ELSEIF [bmi] &gt;=30 THEN &quot;Obesity&quot;&#13;&#10;END' />
      </column>
      <column caption='Excercise Level Category' datatype='string' name='[Calculation_1510240541085698]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [exercise_level] = 0 THEN &quot;Sedantary&quot;&#13;&#10;ELSEIF [exercise_level] = 1 THEN &quot;Moderate&quot;&#13;&#10;ELSEIF [exercise_level] = 2 THEN &quot;Active&quot;&#13;&#10;END' />
      </column>
      <column caption='Level Percent' datatype='integer' datatype-customized='true' name='[Calculation_1510240548024323]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='INT(IF [exercise_level] = 0 THEN &quot;0&quot;&#13;&#10;ELSEIF [exercise_level] = 1 THEN &quot;100&quot;&#13;&#10;ELSEIF [exercise_level] = 2 THEN &quot;200&quot;&#13;&#10;END)' />
